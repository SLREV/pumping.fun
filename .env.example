# ─────────────────────────────────────────────────────────────
#  pumping.fun — contoh konfigurasi
#  Salin:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Network Solana: mainnet-beta | devnet
NETWORK=mainnet-beta

# RPC. Pakai endpoint sendiri (Helius/QuickNode/Triton) untuk produksi.
RPC_URL=https://api.mainnet-beta.solana.com

# Port dashboard
PORT=3000

# URL publik server ini (dipakai kalau metadata & gambar di-host sendiri)
PUBLIC_BASE_URL=http://localhost:3000

# ── Wallet penanda tangan (hot wallet) ───────────────────────
# Base58 secret key ATAU JSON array keypair. Kosongkan untuk mode SIMULASI.
# LAUNCHER_SECRET_KEY=
LAUNCHER_KEYPAIR_PATH=./data/launcher.json

# ── Penyimpanan metadata / gambar ────────────────────────────
# pump  = upload ke endpoint IPFS pump.fun (paling kompatibel dengan UI pump.fun)
# pinata= upload ke Pinata (butuh PINATA_JWT)
# self  = host sendiri di PUBLIC_BASE_URL (cocok untuk devnet / testing)
METADATA_PROVIDER=pump
PINATA_JWT=
PUMP_IPFS_ENDPOINT=https://frontend-api.pump.fun/ipfs

# ── Biaya transaksi ──────────────────────────────────────────
PRIORITY_FEE_MICRO_LAMPORTS=150000
COMPUTE_UNIT_LIMIT=250000

# Harga SOL untuk estimasi USD di dashboard (perkiraan, bukan oracle)
SOL_PRICE_USD=150

# Batas dev buy (SOL) supaya hot wallet tidak terkuras karena salah input
MAX_DEV_BUY_SOL=5
