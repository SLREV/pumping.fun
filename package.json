{
  "name": "pumping.fun",
  "version": "1.0.0",
  "private": true,
  "description": "Launcher token memecoin pump.fun + dashboard ala pump.fun (TypeScript ringan, tanpa framework)",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "launch": "node --env-file-if-exists=.env src/cli/launch.ts",
    "wallet:new": "node src/cli/wallet.ts",
    "selftest": "node --env-file-if-exists=.env src/cli/selftest.ts",
    "typecheck": "tsc --noEmit",
    "test:dom": "node scripts/smoke-dom.mjs",
    "cpi:accounts": "node scripts/cpi-accounts.mjs"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "4.3.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "express": "^4.21.2",
    "bn.js": "^5.2.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
